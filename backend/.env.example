# Copy this file to ".env" and fill in your real values.
# app.py / config.py will read these via python-dotenv.

MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_HOST=localhost
MYSQL_DB=petworld

SECRET_KEY=replace-with-a-long-random-string
JWT_SECRET_KEY=replace-with-another-long-random-string

# Leave blank to just print emails to the console during development
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# Optional: powers the AI Assistant. Leave AI_API_KEY blank to use the
# built-in offline knowledge base (no key and no external calls needed).
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=20
